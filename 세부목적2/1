
# ==============================================================
# 에코델타시티 낙동강 수변 거리별 LST 분석
# 수역 픽셀 제외 + 수역 제외 NDBI 통제
# 2016-2017 vs 2024-2025
# ==============================================================

import ee
import numpy as np
import pandas as pd
import statsmodels.formula.api as smf
import matplotlib.pyplot as plt

# --------------------------------------------------------------
# 1. 기본 설정
# --------------------------------------------------------------
EE_PROJECT = 'glass-potion-508800-r7'

NW_CORNER = (35.1581, 128.9021)
SE_CORNER = (35.1386, 128.9196)

MAX_D = 400
BIN = 30
NB_PX = 3

CRS = 'EPSG:32652'
SCALE = 30

MNDWI_LIMIT = 0.0
MIN_BIN_N = 8

PERIODS = {
    '2016-2017 (before)': (2016, 2017),
    '2024-2025 (after)': (2024, 2025)
}


# --------------------------------------------------------------
# 2. Earth Engine 초기화
# --------------------------------------------------------------
def init():

    try:
        ee.Initialize(project=EE_PROJECT)
    except Exception:
        ee.Authenticate()
        ee.Initialize(project=EE_PROJECT)

    west, north = NW_CORNER[1], NW_CORNER[0]
    east, south = SE_CORNER[1], SE_CORNER[0]

    roi = ee.Geometry.Rectangle(
        [west, south, east, north]
    )

    return roi, roi.buffer(1500)


# --------------------------------------------------------------
# 3. Landsat 전처리
# --------------------------------------------------------------
def prep(img):

    qa = img.select('QA_PIXEL')

    clear = qa.bitwiseAnd(0b11111).eq(0)
    sat = img.select('QA_RADSAT').eq(0)

    sr = (img.select('SR_B.')
          .multiply(0.0000275)
          .add(-0.2))

    lst = (img.select('ST_B10')
           .multiply(0.00341802)
           .add(149.0)
           .subtract(273.15)
           .rename('LST'))

    ndbi = sr.normalizedDifference(
        ['SR_B6', 'SR_B5']
    ).rename('NDBI')

    mndwi = sr.normalizedDifference(
        ['SR_B3', 'SR_B6']
    ).rename('MNDWI')

    return (
        ee.Image.cat([lst, ndbi, mndwi])
        .updateMask(clear.And(sat))
    )


# --------------------------------------------------------------
# 4. Landsat 영상 불러오기
# --------------------------------------------------------------
def get_collection(roi_big, y0, y1, cloud_max):

    l8 = ee.ImageCollection(
        'LANDSAT/LC08/C02/T1_L2'
    )

    l9 = ee.ImageCollection(
        'LANDSAT/LC09/C02/T1_L2'
    )

    return (
        l8.merge(l9)
        .filterBounds(roi_big)
        .filter(ee.Filter.calendarRange(y0, y1, 'year'))
        .filter(ee.Filter.calendarRange(7, 8, 'month'))
        .filter(ee.Filter.eq('PROCESSING_LEVEL', 'L2SP'))
        .filter(ee.Filter.lte('CLOUD_COVER', cloud_max))
    )


# --------------------------------------------------------------
# 5. 수변 거리 및 수역 제외 NDBI 계산
# --------------------------------------------------------------
def sample_period(roi, roi_big, y0, y1, cloud_max,
                  n=6000):

    col = get_collection(
        roi_big, y0, y1, cloud_max
    )

    n_scenes = col.size().getInfo()

    if n_scenes == 0:
        return pd.DataFrame(), 0

    comp = col.map(prep).median()

    # 수역 판별
    water = comp.select('MNDWI').gt(MNDWI_LIMIT)

    # 분석에 사용할 육지
    land = comp.select('MNDWI').lte(MNDWI_LIMIT)

    # ----------------------------------------------------------
    # 5-1. 낙동강 수변 추출
    # ----------------------------------------------------------
    water_mask = water.selfMask()

    river = (
        water_mask
        .connectedPixelCount(256, True)
        .gte(256)
        .unmask(0)
        .reproject(crs=CRS, scale=SCALE)
    )

    # 수변으로부터 거리(m)
    dist = (
        river.fastDistanceTransform(
            neighborhood=30,
            units='pixels',
            metric='squared_euclidean'
        )
        .sqrt()
        .multiply(SCALE)
        .rename('dist')
    )

    # ----------------------------------------------------------
    # 5-2. 수역 픽셀 제외 후 NDBI 계산
    # ----------------------------------------------------------

    # 핵심 변경 부분:
    # NDBI 주변 평균 계산 전에 수역을 마스킹
    ndbi_land = (
        comp.select('NDBI')
        .updateMask(land)
    )

    # 주변 반경 90m NDBI 평균
    # 수역 픽셀은 평균 계산에 포함되지 않음
    ndbi_nb = (
        ndbi_land.reduceNeighborhood(
            reducer=ee.Reducer.mean(),
            kernel=ee.Kernel.circle(
                radius=NB_PX,
                units='pixels'
            )
        )
        .rename('NDBI_nb')
    )

    # ----------------------------------------------------------
    # 5-3. 분석 영상 구성
    # ----------------------------------------------------------
    img = ee.Image.cat([
        comp.select('LST'),
        dist,
        ndbi_nb,
        ee.Image.pixelLonLat()
    ])

    # 수변 거리 조건 + 수역 제외
    mask = (
        dist.gte(BIN)
        .And(dist.lt(MAX_D))
        .And(land)
    )

    img = img.updateMask(mask)

    fc = (
        img.sample(
            region=roi,
            projection=CRS,
            scale=SCALE,
            numPixels=n,
            seed=7,
            dropNulls=True,
            geometries=False,
            tileScale=4
        )
        .limit(5000)
    )

    rows = [
        f['properties']
        for f in fc.getInfo()['features']
    ]

    return pd.DataFrame(rows), n_scenes


# --------------------------------------------------------------
# 6. NDBI 통제 전후 회귀분석
# --------------------------------------------------------------
def analyze(df, label):

    df = df.copy()

    df['bin'] = (
        np.floor(df['dist'] / BIN) * BIN
    ).astype(int)

    # 약 150m 공간 블록
    block = (
        np.floor(df['longitude'] / 0.0015)
        .astype(int).astype(str)
        + '_'
        + np.floor(df['latitude'] / 0.00135)
        .astype(int).astype(str)
    )

    groups = pd.factorize(block)[0]

    print(f'\n[{label}]')
    print('표본 픽셀 수:', len(df))
    print('군집 블록 수:', len(np.unique(groups)))

    # 보정 전
    m0 = smf.ols(
        'LST ~ dist',
        data=df
    ).fit(
        cov_type='cluster',
        cov_kwds={'groups': groups}
    )

    # NDBI 통제 후
    m1 = smf.ols(
        'LST ~ dist + NDBI_nb',
        data=df
    ).fit(
        cov_type='cluster',
        cov_kwds={'groups': groups}
    )

    # NDBI를 표본 평균 수준으로 조정
    mean_ndbi = df['NDBI_nb'].mean()

    df['LST_adj'] = (
        df['LST']
        - m1.params['NDBI_nb']
        * (df['NDBI_nb'] - mean_ndbi)
    )

    def per100(m):

        ci = m.conf_int().loc['dist'] * 100

        return (
            f"{m.params['dist'] * 100:+.3f} ℃/100m "
            f"(95% CI {ci.iloc[0]:+.3f} ~ "
            f"{ci.iloc[1]:+.3f})"
        )

    print('\n거리 100m 증가당 LST 변화')
    print('NDBI 통제 전:', per100(m0))
    print('NDBI 통제 후:', per100(m1))
    print('NDBI 계수:', round(m1.params['NDBI_nb'], 4))

    # 거리 구간별 결과
    curve = df.groupby('bin').agg(
        n=('LST', 'size'),
        LST=('LST', 'mean'),
        LST_adj=('LST_adj', 'mean'),
        NDBI=('NDBI_nb', 'mean')
    )

    all_bins = np.arange(BIN, MAX_D, BIN)

    curve = curve.reindex(all_bins)
    curve['n'] = curve['n'].fillna(0).astype(int)

    print('\n거리별 평균 LST')
    print(curve.round(3))

    return df, curve, m0, m1


# --------------------------------------------------------------
# 7. 개발 전후 비교 그래프
# --------------------------------------------------------------
def plot_curves(curves, title):

    fig, axes = plt.subplots(
        1, 2,
        figsize=(12, 4.5),
        sharey=True
    )

    for ax, (label, c) in zip(axes, curves.items()):

        c = c.copy()

        c.loc[
            c['n'] < MIN_BIN_N,
            ['LST', 'LST_adj']
        ] = np.nan

        x = c.index.to_numpy() + BIN / 2

        ax.plot(
            x,
            c['LST'],
            'o-',
            color='tab:blue',
            label='Raw LST'
        )

        ax.plot(
            x,
            c['LST_adj'],
            's--',
            color='tab:orange',
            label='NDBI-adjusted LST'
        )

        ax.set_title(label)
        ax.set_xlabel('Distance from river (m)')
        ax.set_xticks(x)
        ax.grid(alpha=0.3)
        ax.legend()

    axes[0].set_ylabel('Mean LST (°C)')

    plt.suptitle(title)
    plt.tight_layout()
    plt.show()


# --------------------------------------------------------------
# 8. 개발 후 NDBI 보정 결과 그래프
# --------------------------------------------------------------
def plot_adjusted(curves, cloud_max):

    plt.figure(figsize=(9, 5))

    for label, c in curves.items():

        c = c.copy()

        c.loc[
            c['n'] < MIN_BIN_N,
            'LST_adj'
        ] = np.nan

        x = c.index.to_numpy() + BIN / 2

        plt.plot(
            x,
            c['LST_adj'],
            'o-',
            linewidth=2,
            label=label
        )

    plt.title(
        f'Water-excluded NDBI-adjusted LST '
        f'(Cloud <= {cloud_max}%)'
    )

    plt.xlabel('Distance from river (m)')
    plt.ylabel('Adjusted mean LST (°C)')
    plt.grid(alpha=0.3)
    plt.legend()
    plt.tight_layout()
    plt.show()


# --------------------------------------------------------------
# 9. 전체 실행
# --------------------------------------------------------------
roi, roi_big = init()

all_results = {}

for cloud_max in (20, 10):

    curves = {}
    models = {}

    print('\n================================')
    print(f'구름 피복률 {cloud_max}% 이하')
    print('================================')

    for label, (y0, y1) in PERIODS.items():

        df, n_scenes = sample_period(
            roi, roi_big,
            y0, y1,
            cloud_max
        )

        print(
            f'\n[{label}] '
            f'영상 {n_scenes}장, '
            f'유효 픽셀 {len(df)}개'
        )

        if n_scenes == 0 or len(df) < 100:

            print(
                '장면 또는 표본 부족: 분석 생략'
            )

            continue

        df, curve, m0, m1 = analyze(
            df,
            f'{label}, cloud<={cloud_max}'
        )

        curves[label] = curve

        models[label] = {
            'raw': m0,
            'adjusted': m1
        }

        # 거리별 결과 저장
        curve.to_csv(
            f'River_{y0}_{y1}_cloud{cloud_max}'
            f'_water_excluded.csv',
            encoding='utf-8-sig'
        )

    all_results[cloud_max] = {
        'curves': curves,
        'models': models
    }

    if len(curves) == 2:

        plot_curves(
            curves,
            f'River Distance vs LST '
            f'(Cloud <= {cloud_max}%)'
        )

        plot_adjusted(curves, cloud_max)

    elif len(curves) == 1:

        print(
            '한 기간만 분석 가능하여 '
            '해당 기간 그래프를 출력합니다.'
        )

        plot_adjusted(curves, cloud_max)

print('\n전체 분석 완료')
