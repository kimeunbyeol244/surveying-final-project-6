def create_map(data, label):

    Map = geemap.Map()

    Map.add_basemap('SATELLITE')
    Map.centerObject(roi, 15)

    # 해당 시기의 실제 Landsat 천연색 영상
    Map.addLayer(
        data['comp'].clip(roi_big),
        rgb_vis,
        f'{label} Landsat RGB',
        True
    )

    # MNDWI 전체 분포
    Map.addLayer(
        data['comp'].select('MNDWI').clip(roi_big),
        mndwi_vis,
        'MNDWI',
        False
    )

    # MNDWI > 0 전체 수역
    Map.addLayer(
        data['water'].clip(roi_big),
        {'palette': ['00BFFF']},
        '전체 수역 (MNDWI > 0)',
        False,
        0.6
    )

    # 실제 거리 계산에 사용한 대규모 수역
    Map.addLayer(
        data['river'].clip(roi_big),
        {'palette': ['0066FF']},
        '분석 대상 대규모 수역',
        True,
        0.5
    )

    # 분석 거리 구간
    Map.addLayer(
        data['bins'].clip(roi),
        distance_vis,
        '수변 거리 구간 (30~400m)',
        False,
        0.7
    )

    # 유효 분석 영역
    Map.addLayer(
        data['valid_area'].clip(roi),
        {'palette': ['00FF00']},
        '유효 분석 가능 영역',
        False,
        0.5
    )

    # 지표온도 분포
    Map.addLayer(
        data['comp'].select('LST').clip(roi),
        lst_vis,
        '지표온도 LST',
        False
    )

    # 수변 경계 표시
    Map.addLayer(
        data['boundary'].clip(roi_big),
        {'palette': ['FF0000']},
        '수역 경계',
        True
    )

    # 연구대상지 경계
    roi_outline = ee.Image().byte().paint(
        roi, 1, 2
    )

    Map.addLayer(
        roi_outline.selfMask(),
        {'palette': ['FFFF00']},
        '연구대상지 경계',
        True
    )

    # 범례
    Map.add_legend(
        title='Waterfront analysis',
        legend_dict={
            'River area': '#0066FF',
            'Water boundary': '#FF0000',
            'Study area': '#FFFF00'
        }
    )

    return Map


