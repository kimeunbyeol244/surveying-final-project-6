def dw_raw(year):
    return (ee.ImageCollection('GOOGLE/DYNAMICWORLD/V1')
            .filterBounds(roi)
            .filterDate(f'{year}-07-01', f'{year}-09-01'))


def dw_prob(year):
    return dw_raw(year).select(PROB_BANDS).mean().setDefaultProjection(P10)


def classify(probs, threshold=0.35):
    best = probs.reduce(ee.Reducer.max())
    argmax = probs.toArray().arrayArgmax().arrayGet([0])
    lc10 = (argmax.remap([0,1,2,3,4,5,6,7,8],
                         [4,3,3,3,5,3,1,2,0], 0)
            .rename('LC10')
            .updateMask(best.gte(threshold))
            .updateMask(argmax.neq(8))
            .setDefaultProjection(P10))
    coverage = (lc10.mask().unmask(0).setDefaultProjection(P10)
                .reduceResolution(reducer=ee.Reducer.mean(), maxPixels=256)
                .reproject(P100))
    lc100 = (lc10.reduceResolution(reducer=ee.Reducer.mode(), maxPixels=256)
             .reproject(P100).rename('LC').toInt()
             .updateMask(coverage.gte(MIN_DW_COVER)).clip(roi))
    return lc100

