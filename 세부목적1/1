reg_df = as_df(delta.addBands(fold), ['dLST','dNDVI','dNDBI','dMNDWI','fold'])
cols = ['dLST','dNDVI','dNDBI','dMNDWI']
reg_df = reg_df.dropna(subset=cols+['fold'])
train = reg_df[reg_df.fold!=0]
test = reg_df[reg_df.fold==0]
print('\n[04] 회귀 표본 전체/훈련/검증:', len(reg_df),len(train),len(test))
if len(train)<10 or len(test)<5:
    raise RuntimeError('회귀 표본이 부족함. 경계/자료 마스크를 확인하세요.')
mu = train[cols].mean()
sig = train[cols].std(ddof=0).clip(lower=1e-12)
Ztr = (train[cols]-mu)/sig
Zte = (test[cols]-mu)/sig


def fit(names):
    def matrix(df):
        return np.column_stack([np.ones(len(df)),df[names].to_numpy(dtype=float)])
    y = Ztr['dLST'].to_numpy(dtype=float)
    coef = np.linalg.lstsq(matrix(Ztr),y,rcond=None)[0]
    def r2(df):
        actual = df['dLST'].to_numpy(dtype=float)
        predicted = matrix(df) @ coef
        ss_total = ((actual-actual.mean())**2).sum()
        return 1-((actual-predicted)**2).sum()/ss_total if ss_total>0 else np.nan
    return coef, r2(Ztr),r2(Zte)

specs = [('NDVI 단독',['dNDVI']),('NDBI 단독',['dNDBI']),
         ('MNDWI 단독',['dMNDWI']),('NDBI+MNDWI',['dNDBI','dMNDWI']),
         ('3변수 진단용',['dNDVI','dNDBI','dMNDWI'])]
