# 토지피복 지도 생성
def make_map(lc, years, title):

    m = folium.Map(
        location=[LAT, LON],
        zoom_start=12,
        tiles="OpenStreetMap",
        height=600
    )

    rgb = sentinel_period(
        years[0],
        years[1]
    )

    add_ee_layer(
        m,
        rgb,
        {
            "bands": [
                "red", "green", "blue"
            ],
            "min": 0.02,
            "max": 0.30,
            "gamma": 1.2
        },
        f"{title} 위성영상",
        True
    )

    # 전체 토지피복 5종
    add_ee_layer(
        m,
        lc,
        {
            "min": 1,
            "max": 5,
            "palette": PALETTE
        },
        f"{title} 전체 토지피복 5종",
        True,
        0.65
    )

    # 개별 토지피복 ON/OFF
    for value, name in NAMES.items():

        add_ee_layer(
            m,
            lc.eq(value).selfMask(),
            {
                "palette": [
                    PALETTE[value - 1]
                ]
            },
            f"{title} {name}",
            False,
            0.75
        )

    # 노란색 연구지역 경계
    add_ee_layer(
        m,
        boundary,
        {
            "palette": ["ffff00"]
        },
        "연구지역 경계",
        True
    )

    folium.LayerControl(
        collapsed=False
    ).add_to(m)

    return m


