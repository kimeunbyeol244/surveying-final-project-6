def l8_raw(year):
    return (ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
            .filterBounds(roi)
            .filterDate(f'{year}-07-01', f'{year}-09-01')
            .filter(ee.Filter.eq('PROCESSING_LEVEL', 'L2SP'))
            .filter(ee.Filter.lte('CLOUD_COVER', 80)))


def l8_prepare(img, qa_limit=5):
    qa = img.select('QA_PIXEL')
    valid = (qa.bitwiseAnd(63).eq(0)
             .And(img.select('QA_RADSAT').eq(0))
             .And(img.select('ST_QA').multiply(0.01).lte(qa_limit))
             .And(img.select('ST_CDIST').multiply(0.01).gte(0.2)))
    sr = img.select(['SR_B3','SR_B4','SR_B5','SR_B6']).multiply(0.0000275).add(-0.2)
    green, red, nir, swir = (sr.select(b) for b in ['SR_B3','SR_B4','SR_B5','SR_B6'])

    def index(a, b, name):
        den = a.add(b)
        v = a.subtract(b).divide(den).rename(name)
        return v.updateMask(den.abs().gt(0.01)).updateMask(v.gte(-1).And(v.lte(1)))

    lst = (img.select('ST_B10').multiply(0.00341802)
           .add(149).subtract(273.15).rename('LST'))
    result = ee.Image.cat(lst, index(nir, red, 'NDVI'),
                          index(swir, nir, 'NDBI'), index(green, swir, 'MNDWI'))
    return result.updateMask(valid).copyProperties(img, ['system:time_start'])


def l8_year(year, qa_limit=5):
    return l8_raw(year).map(lambda im: l8_prepare(im, qa_limit)).median()


def make_delta(qa_limit=5):
    yearly = {y:l8_year(y, qa_limit) for y in YEARS}
    before = yearly[2016].add(yearly[2017]).divide(2)
    after = yearly[2024].add(yearly[2025]).divide(2)

    # 30 m 합성 영상을 같은 100 m 격자로 집계
    def aggregate(im):
        return (im.setDefaultProjection(P30)
                .reduceResolution(reducer=ee.Reducer.mean(), maxPixels=1024)
                .reproject(P100).clip(roi))
    before, after = aggregate(before), aggregate(after)
    common = (before.mask().reduce(ee.Reducer.min())
              .And(after.mask().reduce(ee.Reducer.min())))
    before = before.updateMask(common)
    after = after.updateMask(common)
    delta = (after.subtract(before)
             .rename(['dLST','dNDVI','dNDBI','dMNDWI'])
             .updateMask(common).clip(roi))
    return before, after, delta


