def stats(image, reducer=ee.Reducer.mean(), scale=100):
    return image.reduceRegion(reducer=reducer, geometry=roi, crs=CRS,
                              scale=scale, maxPixels=1e9, tileScale=4).getInfo()


def area_km2(mask, scale=100):
    img = ee.Image.pixelArea().rename('area').updateMask(mask)
    x = img.reduceRegion(reducer=ee.Reducer.sum(), geometry=roi,
                         crs=CRS, scale=scale, maxPixels=1e9,
                         tileScale=4).get('area')
    return ee.Number(ee.Algorithms.If(x, x, 0)).divide(1e6).getInfo()


def as_df(image, columns):
    fc = image.select(columns).sample(region=roi, projection=P100,
                                      scale=100, dropNulls=True,
                                      geometries=False, tileScale=4)
    count = fc.size().getInfo()
    rows = []
    for offset in range(0, count, 400):
        sub = ee.FeatureCollection(fc.toList(min(400, count-offset), offset))
        rows += [f['properties'] for f in sub.getInfo()['features']]
    return pd.DataFrame(rows, columns=columns)


