# ============================================================
# 농경지 전환 지도
# ============================================================

transition = (
    lc_before.multiply(10)
    .add(lc_after)
)

transition_map = folium.Map(
    location=[LAT, LON],
    zoom_start=12,
    tiles="OpenStreetMap",
    height=600
)

add_ee_layer(
    transition_map,
    sentinel_period(2024, 2025),
    {
        "bands": ["red", "green", "blue"],
        "min": 0.02,
        "max": 0.30,
        "gamma": 1.2
    },
    "최근 위성영상"
)

# 빨간색: 농경지 → 시가지
add_ee_layer(
    transition_map,
    transition.eq(51).selfMask(),
    {"palette": ["ff2222"]},
    "농경지 → 시가지",
    True,
    0.8
)

# 주황색: 농경지 → 나지
add_ee_layer(
    transition_map,
    transition.eq(52).selfMask(),
    {"palette": ["ffaa00"]},
    "농경지 → 나지",
    True,
    0.8
)

add_ee_layer(
    transition_map,
    boundary,
    {"palette": ["ffff00"]},
    "연구지역 경계"
)

folium.LayerControl(
    collapsed=False
).add_to(transition_map)

print("토지피복 전환 지도")
display(transition_map)

