# Earth Engine 영상을 Folium 지도에 추가
def add_ee_layer(
    map_obj,
    image,
    vis_params,
    name,
    shown=True,
    opacity=1.0
):

    map_id = ee.Image(image).getMapId(
        vis_params
    )

    folium.TileLayer(
        tiles=map_id["tile_fetcher"].url_format,
        attr="Google Earth Engine",
        name=name,
        overlay=True,
        control=True,
        show=shown,
        opacity=opacity
    ).add_to(map_obj)


# Sentinel-2 영상 불러오기
def sentinel(year):

    collection = (
        ee.ImageCollection(
            "COPERNICUS/S2_HARMONIZED"
        )
        .filterBounds(roi.buffer(1200))
        .filterDate(
            f"{year}-07-01",
            f"{year}-09-01"
        )
        .filter(
            ee.Filter.lte(
                "CLOUDY_PIXEL_PERCENTAGE",
                60
            )
        )
    )

    def prep(image):

        qa = image.select("QA60")

        clear = (
            qa.bitwiseAnd(1 << 10).eq(0)
            .And(
                qa.bitwiseAnd(1 << 11).eq(0)
            )
        )

        return (
            image.select(
                ["B4", "B3", "B2"],
                ["red", "green", "blue"]
            )
            .multiply(0.0001)
            .updateMask(clear)
        )

    return collection.map(prep).median()


# 두 해의 위성영상 합성
def sentinel_period(year1, year2):

    return ee.ImageCollection.fromImages([
        sentinel(year1),
        sentinel(year2)
    ]).mean().clip(roi.buffer(1200))


# 연구지역 중심
