# ==============================================================
# 부산 에코델타시티 R23 녹지 경계 거리별 LST 분석
# 2016-2017 vs 2024-2025
#
# NDVI >= 0.20 : 녹지 픽셀만 제외
# MNDWI >= 0   : 수역 픽셀 제외하지 않음
# NDBI         : 회귀분석 통제
# LST          : 종속변수
# ==============================================================

import ee
import numpy as np
import pandas as pd
import statsmodels.formula.api as smf
import matplotlib.pyplot as plt

# --------------------------------------------------------------
# 1. 기본 설정
# --------------------------------------------------------------
EE_PROJECT = 'glass-potion-508800-r7'

NW_CORNER = (35.1581, 128.9021)
SE_CORNER = (35.1386, 128.9196)

CRS = 'EPSG:32652'
SCALE = 30
CLOUD_MAX = 20

NDVI_LIMIT = 0.20

MAX_D = 150
BIN = 30
MIN_BIN_N = 8

PERIODS = {
    '2016-2017': (2016, 2017),
    '2024-2025': (2024, 2025)
}


# --------------------------------------------------------------
# 2. Earth Engine 초기화
# --------------------------------------------------------------
try:
    ee.Initialize(project=EE_PROJECT)
except Exception:
    ee.Authenticate()
    ee.Initialize(project=EE_PROJECT)

west = NW_CORNER[1]
north = NW_CORNER[0]
east = SE_CORNER[1]
south = SE_CORNER[0]

dlon = (east - west) / 3
dlat = (north - south) / 3

# R23 = 2행 3열
r23_west = west + 2 * dlon
r23_east = east
r23_north = north - dlat
r23_south = north - 2 * dlat

roi = ee.Geometry.Rectangle(
    [r23_west, r23_south, r23_east, r23_north],
    proj='EPSG:4326',
    geodesic=False
)

# R23 밖의 녹지도 거리 계산에 반영
roi_big = roi.buffer(1000)

print('R23 좌표')
print('NW:', r23_north, r23_west)
print('SE:', r23_south, r23_east)


# --------------------------------------------------------------
# 3. Landsat 영상 불러오기
# --------------------------------------------------------------
def get_collection(y0, y1):

    l8 = ee.ImageCollection(
        'LANDSAT/LC08/C02/T1_L2'
    )

    l9 = ee.ImageCollection(
        'LANDSAT/LC09/C02/T1_L2'
    )

    return (
        l8.merge(l9)
        .filterBounds(roi_big)
        .filter(ee.Filter.calendarRange(y0, y1, 'year'))
        .filter(ee.Filter.calendarRange(7, 8, 'month'))
        .filter(ee.Filter.eq('PROCESSING_LEVEL', 'L2SP'))
        .filter(ee.Filter.lte('CLOUD_COVER', CLOUD_MAX))
    )


# --------------------------------------------------------------
# 4. LST, NDVI, NDBI, MNDWI
# --------------------------------------------------------------
def prep(img):

    qa = img.select('QA_PIXEL')

    clear = qa.bitwiseAnd(0b11111).eq(0)
    sat = img.select('QA_RADSAT').eq(0)

    sr = (
        img.select('SR_B.')
        .multiply(0.0000275)
        .add(-0.2)
    )

    lst = (
        img.select('ST_B10')
        .multiply(0.00341802)
        .add(149.0)
        .subtract(273.15)
        .rename('LST')
    )

    ndvi = sr.normalizedDifference(
        ['SR_B5', 'SR_B4']
    ).rename('NDVI')

    ndbi = sr.normalizedDifference(
        ['SR_B6', 'SR_B5']
    ).rename('NDBI')

    mndwi = sr.normalizedDifference(
        ['SR_B3', 'SR_B6']
    ).rename('MNDWI')

    return (
        ee.Image.cat([
            lst, ndvi, ndbi, mndwi
        ])
        .updateMask(clear.And(sat))
    )


# --------------------------------------------------------------
# 5. 녹지 경계 거리 및 픽셀 추출
# --------------------------------------------------------------
def sample_period(y0, y1):

    col = get_collection(y0, y1)
    n_scenes = col.size().getInfo()

    if n_scenes == 0:
        return pd.DataFrame(), 0

    comp = col.map(prep).median()

    ndvi = comp.select('NDVI')

    # ----------------------------------------------------------
    # 5-1. 녹지 픽셀 정의
    # ----------------------------------------------------------
    green = ndvi.gte(NDVI_LIMIT)

    # 녹지 픽셀만 제외
    # 수역 픽셀은 별도로 제거하지 않음
    analysis_mask = green.Not()

    # ----------------------------------------------------------
    # 5-2. 녹지 경계 거리 계산
    # ----------------------------------------------------------
    # 수역 마스크는 적용하지 않음
    green_source = (
        green
        .unmask(0)
        .reproject(crs=CRS, scale=SCALE)
    )

    dist = (
        green_source.fastDistanceTransform(
            neighborhood=30,
            units='pixels',
            metric='squared_euclidean'
        )
        .sqrt()
        .multiply(SCALE)
        .subtract(SCALE / 2)
        .max(0)
        .rename('dist')
    )

    # 공간 블록 계산을 위한 좌표
    xy = ee.Image.pixelCoordinates(
        ee.Projection(CRS).atScale(SCALE)
    )

    # ----------------------------------------------------------
    # 5-3. 분석 영상 구성
    # ----------------------------------------------------------
    img = ee.Image.cat([
        comp.select('LST'),
        comp.select('NDBI'),
        dist,
        xy
    ])

    mask = (
        analysis_mask
        .And(dist.gte(0))
        .And(dist.lt(MAX_D))
    )

    img = img.updateMask(mask)

    # R23 영역만 추출
    fc = img.sample(
        region=roi,
        projection=CRS,
        scale=SCALE,
        dropNulls=True,
        geometries=False,
        tileScale=4
    )

    rows = [
        f['properties']
        for f in fc.getInfo()['features']
    ]

    return pd.DataFrame(rows), n_scenes


# --------------------------------------------------------------
# 6. NDBI 보정 및 거리별 LST 분석
# --------------------------------------------------------------
def analyze(df, label, ref_ndbi):

    df = df.copy()

    # 거리 구간 설정
    df['bin'] = (
        np.floor(df['dist'] / BIN) * BIN
    ).astype(int)

    # 그래프 X축: 구간 상한
    df['distance_plot'] = df['bin'] + BIN

    # 약 150m 공간 블록
    block = (
        np.floor(df['x'] / 5)
        .astype(int).astype(str)
        + '_'
        + np.floor(df['y'] / 5)
        .astype(int).astype(str)
    )

    groups = pd.factorize(block)[0]
    n_blocks = len(np.unique(groups))

    # NDBI 통제 전
    m0 = smf.ols(
        'LST ~ dist',
        data=df
    ).fit()

    # NDBI 통제 후
    m1 = smf.ols(
        'LST ~ dist + NDBI',
        data=df
    ).fit()

    if m1.model.rank < 3:
        raise ValueError(
            '거리와 NDBI의 독립적인 변동이 부족합니다.'
        )

    # 공간 블록이 2개 이상일 때 군집 표준오차
    if n_blocks >= 2:

        m0 = smf.ols(
            'LST ~ dist',
            data=df
        ).fit(
            cov_type='cluster',
            cov_kwds={'groups': groups}
        )

        m1 = smf.ols(
            'LST ~ dist + NDBI',
            data=df
        ).fit(
            cov_type='cluster',
            cov_kwds={'groups': groups}
        )

    # ----------------------------------------------------------
    # 6-1. 공통 NDBI 기준으로 LST 보정
    # ----------------------------------------------------------
    df['LST_adj'] = (
        df['LST']
        - m1.params['NDBI']
        * (df['NDBI'] - ref_ndbi)
    )

    def per100(m):

        ci = m.conf_int().loc['dist'] * 100

        return (
            f"{m.params['dist'] * 100:+.3f} ℃/100m "
            f"(95% CI "
            f"{ci.iloc[0]:+.3f} ~ "
            f"{ci.iloc[1]:+.3f})"
        )

    print(f'\n[{label}]')
    print('유효 픽셀:', len(df))
    print('공간 블록:', n_blocks)

    print('NDBI 통제 전:', per100(m0))
    print('NDBI 통제 후:', per100(m1))
    print(
        'NDBI 회귀계수:',
        round(m1.params['NDBI'], 4)
    )

    # ----------------------------------------------------------
    # 6-2. 거리별 평균
    # ----------------------------------------------------------
    curve = df.groupby('bin').agg(
        n=('LST', 'size'),
        LST=('LST', 'mean'),
        LST_adj=('LST_adj', 'mean'),
        NDBI=('NDBI', 'mean')
    )

    curve = curve.reindex(
        np.arange(0, MAX_D, BIN)
    )

    curve['n'] = (
        curve['n']
        .fillna(0)
        .astype(int)
    )

    curve['distance_plot'] = (
        curve.index + BIN
    )

    print('\n거리별 평균 LST')
    print(curve.round(3))

    return df, curve, m0, m1


# --------------------------------------------------------------
# 7. 개발 전후 픽셀 수집
# --------------------------------------------------------------
samples = {}
scene_counts = {}

for label, (y0, y1) in PERIODS.items():

    df, n_scenes = sample_period(y0, y1)

    samples[label] = df
    scene_counts[label] = n_scenes

    print(
        f'{label}: '
        f'장면 {n_scenes}개, '
        f'유효 픽셀 {len(df)}개'
    )


# --------------------------------------------------------------
# 8. 공통 NDBI 기준 계산
# --------------------------------------------------------------
valid_samples = [
    df for df in samples.values()
    if len(df) > 0
]

if len(valid_samples) == 0:
    raise ValueError(
        'R23에서 유효 픽셀이 없습니다.'
    )

combined = pd.concat(
    valid_samples,
    ignore_index=True
)

ref_ndbi = combined['NDBI'].mean()

print(
    '\n공통 기준 NDBI:',
    round(ref_ndbi, 4)
)


# --------------------------------------------------------------
# 9. 각 기간별 회귀분석
# --------------------------------------------------------------
curves = {}
models = {}

for label, df in samples.items():

    if len(df) < 30:

        print(
            f'{label}: '
            '표본 부족으로 회귀분석 생략'
        )

        continue

    try:

        df, curve, m0, m1 = analyze(
            df,
            label,
            ref_ndbi
        )

        samples[label] = df
        curves[label] = curve

        models[label] = {
            'raw': m0,
            'adjusted': m1
        }

        curve.to_csv(
            f'R23_{label}_green_only_mask.csv',
            encoding='utf-8-sig'
        )

    except ValueError as e:
        print(f'{label}: {e}')


# --------------------------------------------------------------
# 10. 거리별 평균 LST 그래프
# --------------------------------------------------------------
plt.figure(figsize=(9, 5.5))

colors = {
    '2016-2017': 'tab:blue',
    '2024-2025': 'tab:orange'
}

for label, curve in curves.items():

    c = curve.copy()

    c.loc[
        c['n'] < MIN_BIN_N,
        ['LST', 'LST_adj']
    ] = np.nan

    x = c['distance_plot']

    plt.plot(
        x,
        c['LST'],
        'o--',
        color=colors[label],
        alpha=0.4,
        label=f'{label} Raw'
    )

    plt.plot(
        x,
        c['LST_adj'],
        's-',
        color=colors[label],
        linewidth=2,
        label=f'{label} NDBI-adjusted'
    )

plt.title(
    'R23 - Green Boundary Distance vs LST'
)

plt.xlabel(
    'Distance bin upper bound (m)'
)

plt.ylabel(
    'Mean LST (°C)'
)

plt.xticks(
    np.arange(30, MAX_D + 1, BIN)
)

plt.grid(alpha=0.3)

if len(curves) > 0:
    plt.legend()
else:
    plt.text(
        0.5, 0.5,
        'Insufficient data',
        transform=plt.gca().transAxes,
        ha='center',
        va='center'
    )

plt.tight_layout()

plt.savefig(
    'R23_green_only_LST_comparison.png',
    dpi=200,
    bbox_inches='tight'
)

plt.show()


# --------------------------------------------------------------
# 11. NDBI 보정 후 평균 LST 그래프
# --------------------------------------------------------------
plt.figure(figsize=(8, 5))

for label, curve in curves.items():

    c = curve.copy()

    c.loc[
        c['n'] < MIN_BIN_N,
        'LST_adj'
    ] = np.nan

    x = c['distance_plot']

    plt.plot(
        x,
        c['LST_adj'],
        'o-',
        linewidth=2,
        color=colors[label],
        label=label
    )

plt.title(
    'R23 - NDBI-adjusted LST'
)

plt.xlabel(
    'Distance bin upper bound (m)'
)

plt.ylabel(
    'Adjusted mean LST (°C)'
)

plt.xticks(
    np.arange(30, MAX_D + 1, BIN)
)

plt.grid(alpha=0.3)

if len(curves) > 0:
    plt.legend()

plt.tight_layout()

plt.savefig(
    'R23_green_only_adjusted_LST.png',
    dpi=200,
    bbox_inches='tight'
)

plt.show()


# --------------------------------------------------------------
# 12. NDBI 보정 전후 산점도
# --------------------------------------------------------------
fig, axes = plt.subplots(
    2, 2,
    figsize=(13, 10),
    sharex=True
)

for i, label in enumerate(PERIODS):

    df = samples.get(label)

    if df is None or 'LST_adj' not in df.columns:

        for j in range(2):
            axes[i, j].text(
                0.5, 0.5,
                'Insufficient data',
                transform=axes[i, j].transAxes,
                ha='center',
                va='center'
            )

        continue

    df = df.copy()

    # 실제 픽셀 거리를 사용한 회귀모형
    m0 = models[label]['raw']
    m1 = models[label]['adjusted']

    # 보정 LST에 대한 단순 선형회귀
    m_adj = smf.ols(
        'LST_adj ~ dist',
        data=df
    ).fit()

    x_line = np.linspace(
        df['dist'].min(),
        df['dist'].max(),
        100
    )

    # ----------------------------------------------------------
    # 왼쪽: NDBI 통제 전
    # ----------------------------------------------------------
    ax = axes[i, 0]

    ax.scatter(
        df['dist'],
        df['LST'],
        s=12,
        alpha=0.22,
        color='gray'
    )

    y_raw = (
        m0.params['Intercept']
        + m0.params['dist'] * x_line
    )

    ax.plot(
        x_line,
        y_raw,
        color='red',
        linewidth=2
    )

    ax.set_title(f'{label} - Raw LST')
    ax.set_ylabel('LST (°C)')
    ax.grid(alpha=0.25)

    ax.text(
        0.04, 0.95,
        f"Slope = {m0.params['dist'] * 100:+.3f}"
        " °C/100m\n"
        f"R² = {m0.rsquared:.3f}",
        transform=ax.transAxes,
        va='top',
        fontsize=10
    )

    # ----------------------------------------------------------
    # 오른쪽: NDBI 통제 후
    # ----------------------------------------------------------
    ax = axes[i, 1]

    ax.scatter(
        df['dist'],
        df['LST_adj'],
        s=12,
        alpha=0.25,
        color='tab:blue'
    )

    y_adj = (
        m_adj.params['Intercept']
        + m_adj.params['dist'] * x_line
    )

    ax.plot(
        x_line,
        y_adj,
        color='red',
        linewidth=2
    )

    ax.set_title(
        f'{label} - NDBI-adjusted LST'
    )

    ax.grid(alpha=0.25)

    ax.text(
        0.04, 0.95,
        f"Slope = {m1.params['dist'] * 100:+.3f}"
        " °C/100m\n"
        f"R² = {m_adj.rsquared:.3f}",
        transform=ax.transAxes,
        va='top',
        fontsize=10
    )

for ax in axes.flat:
    ax.set_xlim(0, MAX_D)
    ax.set_xticks(
        np.arange(30, MAX_D + 1, BIN)
    )

for ax in axes[-1, :]:
    ax.set_xlabel(
        'Distance from green boundary (m)'
    )

plt.suptitle(
    'R23 - Green Boundary Distance vs LST',
    fontsize=15,
    fontweight='bold'
)

plt.tight_layout()

plt.savefig(
    'R23_green_only_scatter.png',
    dpi=250,
    bbox_inches='tight'
)

plt.show()

print('\nR23 분석 완료')
