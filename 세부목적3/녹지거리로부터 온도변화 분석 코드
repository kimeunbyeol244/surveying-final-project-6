    d['GreenBin'] = pd.Categorical(d['GreenBin'], categories=DIST_LABELS, ordered=True)
    if len(d) < 35 or d['GreenBin'].nunique() < 4:
        return d.assign(AdjLST=np.nan), None
    # Avoid exact singular design and prohibit presenting unstable regressions as measurements.
    x = d[COVS].to_numpy(dtype=float)
    if np.linalg.matrix_rank(np.column_stack([np.ones(len(x)), x])) < 5:
        return d.assign(AdjLST=np.nan), None
    try:
        mod = smf.ols(FORMULA, data=d).fit(cov_type='HC3')
        means = d[COVS].mean()
        correction = sum(mod.params.get(v,0.0) * (d[v] - means[v]) for v in COVS)
        d['AdjLST'] = d['LST'] - correction
        return d, mod
    except Exception as exc:
        warnings.warn(f'Regression failed: {exc}')
        return d.assign(AdjLST=np.nan), None

records, bins_records, models = [], [], []
for c in candidates:
    for label, _, _ in PERIODS:
        sub = all_samples.loc[within[c['Candidate']] & all_samples['Period'].eq(label)].copy()
        if sub.empty:
            continue
        d, model = fit_adjust(sub)
        groups = d.groupby('GreenBin', observed=False)
        tab = groups.agg(N=('LST','size'), Raw_LST=('LST','mean'),
                         Adjusted_LST=('AdjLST','mean'),
                         Mean_NDVI=('NDVI','mean'), Mean_NDBI=('NDBI','mean'),
                         Built_Proxy=('BuiltFrac','mean'),
                         Mean_River_Distance=('RiverDist','mean')).reindex(DIST_LABELS)
        for b, r in tab.iterrows():
            bins_records.append({'Candidate':c['Candidate'], 'Period':label,
                                 'Green_Distance_Bin_m':b, **r.to_dict()})
        n_near = int(tab.loc['0-30','N']) if pd.notna(tab.loc['0-30','N']) else 0
        n_far = int(tab.loc['120-150','N']) if pd.notna(tab.loc['120-150','N']) else 0
        valid = (model is not None and n_near >= 5 and n_far >= 5 and
                 pd.notna(tab.loc['0-30','Adjusted_LST']) and
                 pd.notna(tab.loc['120-150','Adjusted_LST']))
        raw_rise = (tab.loc['120-150','Raw_LST'] - tab.loc['0-30','Raw_LST']) if n_near and n_far else np.nan
        adj_rise = (tab.loc['120-150','Adjusted_LST'] - tab.loc['0-30','Adjusted_LST']) if valid else np.nan
        records.append({'Candidate':c['Candidate'], 'Period':label,
                        'N_total':len(d), 'N_near':n_near, 'N_far':n_far,
                        'Raw_Rise_C':raw_rise, 'Adjusted_Rise_C':adj_rise,
                        'Eligible_For_Ranking':bool(valid),
                        'Regression_R2':model.rsquared if model is not None else np.nan})
        if model is not None:
            models.append({'Candidate':c['Candidate'], 'Period':label,
                           **{f'coef_{k}':float(v) for k,v in model.params.items()}})

bin_df = pd.DataFrame(bins_records)
score_df = pd.DataFrame(records)
model_df = pd.DataFrame(models)
post = score_df[score_df['Period'] == '2024-2025'].copy()
post['Ranking_Rise_C'] = np.where(post['Eligible_For_Ranking'],post['Adjusted_Rise_C'],np.nan)
post = post.sort_values('Ranking_Rise_C', ascending=False, na_position='last').reset_index(drop=True)
post['Rank'] = np.nan  # No ranking with only one observation window
post.loc[post['Ranking_Rise_C'].isna(),'Rank'] = np.nan

# Relative difference between periods in R23 (not necessarily identical land pixels).
pre = score_df[score_df['Period']=='2016-2017'][['Candidate','Adjusted_Rise_C']].rename(columns={'Adjusted_Rise_C':'Pre_Rise_C'})
