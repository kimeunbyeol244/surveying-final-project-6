
# ============================================================
# 부산 에코델타시티 세부목적 3
# 녹지 경계로부터 거리별 평균 LST
# 수역 제외 없음 / NDBI만 회귀 보정
#
# 개발 전: 2016-2017년 7~8월
# 개발 후: 2024-2025년 7~8월
# 녹지 기준: NDVI >= 0.20
# 거리: 0-30, 30-60, 60-90, 90-120, 120-150m
# ============================================================

import ee
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from IPython.display import display

# 1. Google Earth Engine 초기화
PROJECT = 'glass-potion-508800-r7'

try:
    ee.Initialize(project=PROJECT)
except Exception:
    ee.Authenticate()
    ee.Initialize(project=PROJECT)

# 2. 분석 설정
roi = ee.Geometry.Rectangle([
    128.9021, 35.1386,
    128.9196, 35.1581
])

# 연구구역 경계 근처의 녹지도 거리 계산에 반영
work_roi = roi.buffer(400)

CRS = 'EPSG:32652'
SCALE = 30
CLOUD_LIMIT = 20
GREEN_THRESHOLD = 0.20

DISTANCES = [30, 60, 90, 120, 150]

PERIODS = [
    ('2016-2017', 2016, 2017),
    ('2024-2025', 2024, 2025)
]

# 3. Landsat 전처리
def preprocess(image):
    image = ee.Image(image)

    qa = image.select('QA_PIXEL')
    cloud_mask = qa.bitwiseAnd(63).eq(0)
    saturation_mask = image.select('QA_RADSAT').eq(0)

    optical = (
        image.select(['SR_B4', 'SR_B5', 'SR_B6'])
        .multiply(0.0000275)
        .subtract(0.2)
    )

    red = optical.select('SR_B4')
    nir = optical.select('SR_B5')
    swir1 = optical.select('SR_B6')

    ndvi = (
        nir.subtract(red)
        .divide(nir.add(red))
        .rename('NDVI')
    )

    ndbi = (
        swir1.subtract(nir)
        .divide(swir1.add(nir))
        .rename('NDBI')
    )

    lst = (
        image.select('ST_B10')
        .multiply(0.00341802)
        .add(149)
        .subtract(273.15)
        .rename('LST')
    )

    valid = (
        ndvi.gte(-1).And(ndvi.lte(1))
        .And(ndbi.gte(-1)).And(ndbi.lte(1))
    )

    return (
        ee.Image.cat([ndvi, ndbi, lst])
        .updateMask(
            cloud_mask
            .And(saturation_mask)
            .And(valid)
        )
    )

# 4. Landsat 8/9 수집
landsat = (
    ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
    .merge(
        ee.ImageCollection('LANDSAT/LC09/C02/T1_L2')
    )
    .filterBounds(work_roi)
    .filter(ee.Filter.calendarRange(7, 8, 'month'))
    .filter(ee.Filter.lte('CLOUD_COVER', CLOUD_LIMIT))
    .filter(ee.Filter.eq('PROCESSING_LEVEL', 'L2SP'))
)

def get_composite(y1, y2):
    yearly = []

    for year in [y1, y2]:
        col = landsat.filter(
            ee.Filter.calendarRange(year, year, 'year')
        )

        count = col.size().getInfo()
        print(f'{year}년 영상 수: {count}')

        if count == 0:
            raise ValueError(
                f'{year}년 사용 가능한 영상이 없습니다.'
            )

        yearly.append(
            ee.Image(col.map(preprocess).median())
        )

    # 각 연도의 영상을 합성한 뒤 연도별 동일 가중 평균
    return (
        ee.ImageCollection.fromImages(yearly)
        .mean()
        .clip(work_roi)
        .reproject(crs=CRS, scale=SCALE)
    )

# 5. 녹지 경계로부터 거리 계산
def make_distance(image):
    ndvi = image.select('NDVI')

    # 수역 제외 없이 NDVI 기준만 사용
    vegetation = ndvi.gte(GREEN_THRESHOLD)

    green_binary = (
        vegetation.unmask(0)
        .toByte()
        .reproject(crs=CRS, scale=SCALE)
    )

    center_distance = (
        green_binary.fastDistanceTransform(
            neighborhood=20,
            units='pixels',
            metric='squared_euclidean'
        )
        .sqrt()
        .multiply(SCALE)
    )

    # 녹지 픽셀 중심 거리에서 15m를 빼
    # 녹지 픽셀 경계까지의 거리를 근사
    edge_distance = (
        center_distance
        .subtract(SCALE / 2)
        .max(0)
        .rename('Distance')
    )

    # 녹지 내부 픽셀은 분석 대상에서 제외
    return edge_distance.updateMask(
        vegetation.Not().And(ndvi.mask())
    )

# 6. NDBI 회귀 보정
def adjust_ndbi(image, distance):
    lst = image.select('LST')
    ndbi = image.select('NDBI')

    # 0~150m 녹지 외부 픽셀 전체를 회귀 표본으로 사용
    valid_mask = (
        distance.gte(0)
        .And(distance.lte(150))
        .And(lst.mask())
        .And(ndbi.mask())
    )

    # LST = alpha + beta * Distance100 + gamma * NDBI
    regression_image = ee.Image.cat([
        ee.Image.constant(1).rename('Intercept'),
        distance.divide(100).rename('Distance100'),
        ndbi,
        lst
    ]).updateMask(valid_mask)

    regression = regression_image.reduceRegion(
        reducer=ee.Reducer.linearRegression(
            numX=3,
            numY=1
        ),
        geometry=roi,
        scale=SCALE,
        crs=CRS,
        maxPixels=1e9,
        tileScale=4
    )

    coefficients = regression.get('coefficients').getInfo()

    if coefficients is None:
        raise ValueError(
            '유효한 회귀 표본이 부족하여 NDBI 보정이 불가능합니다.'
        )

    alpha = float(coefficients[0][0])
    beta_distance = float(coefficients[1][0])
    gamma_ndbi = float(coefficients[2][0])

    # 회귀에 사용한 표본의 평균 NDBI
    ref_ndbi = ndbi.updateMask(valid_mask).reduceRegion(
        reducer=ee.Reducer.mean(),
        geometry=roi,
        scale=SCALE,
        crs=CRS,
        maxPixels=1e9,
        tileScale=4
    ).get('NDBI').getInfo()

    # NDBI의 차이로 설명되는 LST 성분만 보정
    adjusted_lst = (
        lst.subtract(
            ndbi.subtract(float(ref_ndbi))
            .multiply(gamma_ndbi)
        )
        .rename('Adjusted_LST')
    )

    print(f'  NDBI 회귀계수: {gamma_ndbi:.4f}')
    print(f'  거리 회귀계수: {beta_distance:.4f} °C/100m')
    print(f'  기준 평균 NDBI: {ref_ndbi:.4f}')

    return adjusted_lst, {
        'Intercept': alpha,
        'Distance_C_per_100m': beta_distance,
        'NDBI_Coefficient': gamma_ndbi,
        'Reference_NDBI': float(ref_ndbi)
    }

# 7. 거리 구간별 보정 전후 평균 LST
def analyze_period(image, period):
    lst = image.select('LST')
    ndbi = image.select('NDBI')
    distance = make_distance(image)

    adjusted_lst, coefficients = adjust_ndbi(
        image, distance
    )

    valid_mask = (
        lst.mask()
        .And(ndbi.mask())
        .And(distance.mask())
    )

    rows = []

    for upper in DISTANCES:
        lower = upper - 30

        if lower == 0:
            ring = (
                distance.gte(0)
                .And(distance.lte(30))
            )
        else:
            ring = (
                distance.gt(lower)
                .And(distance.lte(upper))
            )

        mask = ring.And(valid_mask)

        data = (
            ee.Image.cat([
                lst.rename('Raw_LST'),
                adjusted_lst.rename('Adjusted_LST')
            ])
            .updateMask(mask)
        )

        stats = data.reduceRegion(
            reducer=(
                ee.Reducer.mean()
                .combine(
                    reducer2=ee.Reducer.count(),
                    sharedInputs=True
                )
            ),
            geometry=roi,
            scale=SCALE,
            crs=CRS,
            maxPixels=1e9,
            tileScale=4
        ).getInfo()

        rows.append({
            'Period': period,
            'Distance_Range': f'{lower}-{upper}m',
            'Distance_Mid': (lower + upper) / 2,
            'Before_NDBI_Adjustment': stats.get('Raw_LST_mean'),
            'After_NDBI_Adjustment': stats.get('Adjusted_LST_mean'),
            'Valid_Pixels': stats.get('Raw_LST_count', 0)
        })

    return pd.DataFrame(rows), coefficients

# 8. 개발 전후 분석 실행
results = []
regression_results = []

for period, y1, y2 in PERIODS:
    print(f'\n분석 중: {period}')

    image = get_composite(y1, y2)

    period_df, coef = analyze_period(
        image, period
    )

    results.append(period_df)
    regression_results.append({
        'Period': period,
        **coef
    })

df = pd.concat(results, ignore_index=True)
coef_df = pd.DataFrame(regression_results)

# 9. 결과표
distance_labels = [
    '0-30m', '30-60m', '60-90m',
    '90-120m', '120-150m'
]

print('\n[표 1] NDBI 보정 전후 거리별 평균 LST (°C)')
display(df.round(3))

raw_table = df.pivot(
    index='Distance_Range',
    columns='Period',
    values='Before_NDBI_Adjustment'
).reindex(distance_labels)

adjusted_table = df.pivot(
    index='Distance_Range',
    columns='Period',
    values='After_NDBI_Adjustment'
).reindex(distance_labels)

pixel_table = df.pivot(
    index='Distance_Range',
    columns='Period',
    values='Valid_Pixels'
).reindex(distance_labels)

print('\n[표 2] NDBI 보정 전 평균 LST (°C)')
display(raw_table.round(2))

print('\n[표 3] NDBI 보정 후 평균 LST (°C)')
display(adjusted_table.round(2))

print('\n[표 4] 거리별 유효 픽셀 수')
display(pixel_table)

print('\n[표 5] 회귀계수')
display(coef_df.round(4))

# 10. 그래프: 보정 전후 비교
fig, axes = plt.subplots(
    1, 2, figsize=(13, 5),
    sharey=True
)

colors = {
    '2016-2017': '#2878B5',
    '2024-2025': '#D95F02'
}

for period in ['2016-2017', '2024-2025']:
    sub = df[df['Period'] == period].sort_values(
        'Distance_Mid'
    )

    x = sub['Distance_Mid'].to_numpy()

    raw = sub['Before_NDBI_Adjustment'].to_numpy(
        dtype=float
    )
    adjusted = sub['After_NDBI_Adjustment'].to_numpy(
        dtype=float
    )

    axes[0].plot(
        x, raw,
        marker='o', linewidth=2,
        color=colors[period],
        label=period
    )

    axes[1].plot(
        x, adjusted,
        marker='o', linewidth=2,
        color=colors[period],
        label=period
    )

axes[0].set_title('Before NDBI Adjustment')
axes[1].set_title('After NDBI Adjustment')

for ax in axes:
    ax.set_xlabel('Distance from vegetation boundary (m)')
    ax.set_xticks([15, 45, 75, 105, 135])
    ax.set_xticklabels(distance_labels, rotation=25)
    ax.grid(True, alpha=0.3)
    ax.legend()

axes[0].set_ylabel('Mean LST (°C)')

fig.suptitle(
    'Vegetation Distance vs. LST',
    fontsize=14
)

plt.tight_layout()
plt.savefig(
    'Vegetation_LST_NDBI_Adjustment.png',
    dpi=300,
    bbox_inches='tight'
)
plt.show()

