import ee
import geemap
from IPython.display import display

# ============================================================
# 1. 기본 설정
# ============================================================

EE_PROJECT = 'glass-potion-508800-r7'

NW_CORNER = (35.1581, 128.9021)
SE_CORNER = (35.1386, 128.9196)

CRS = 'EPSG:32652'
SCALE = 30
CLOUD_MAX = 20

NDVI_LIMIT = 0.20
MAX_D = 150
BIN = 30

# ============================================================
# 2. Earth Engine 초기화
# ============================================================

try:
    ee.Initialize(project=EE_PROJECT)
except Exception:
    ee.Authenticate()
    ee.Initialize(project=EE_PROJECT)

west = NW_CORNER[1]
north = NW_CORNER[0]
east = SE_CORNER[1]
south = SE_CORNER[0]

# 전체 연구대상지
roi_total = ee.Geometry.Rectangle(
    [west, south, east, north],
    proj='EPSG:4326',
    geodesic=False
)

# ============================================================
# 3. R23 경계 설정
# ============================================================

dlon = (east - west) / 3
dlat = (north - south) / 3

r23_west = west + 2 * dlon
r23_east = east

r23_north = north - dlat
r23_south = north - 2 * dlat

roi = ee.Geometry.Rectangle(
    [r23_west, r23_south, r23_east, r23_north],
    proj='EPSG:4326',
    geodesic=False
)

roi_big = roi.buffer(1000)

print('R23 좌표')
print('NW:', r23_north, r23_west)
print('SE:', r23_south, r23_east)

# ============================================================
# 4. Landsat 영상 수집
# ============================================================

def get_collection(y0, y1):

    l8 = ee.ImageCollection(
        'LANDSAT/LC08/C02/T1_L2'
    )

    l9 = ee.ImageCollection(
        'LANDSAT/LC09/C02/T1_L2'
    )

    return (
        l8.merge(l9)
        .filterBounds(roi_big)
        .filter(
            ee.Filter.calendarRange(y0, y1, 'year')
        )
        .filter(
            ee.Filter.calendarRange(7, 8, 'month')
        )
        .filter(
            ee.Filter.eq('PROCESSING_LEVEL', 'L2SP')
        )
        .filter(
            ee.Filter.lte('CLOUD_COVER', CLOUD_MAX)
        )
    )

# ============================================================
# 5. Landsat 전처리
# 기존 R23 분석 코드와 동일
# ============================================================

def prep(img):

    qa = img.select('QA_PIXEL')

    clear = qa.bitwiseAnd(0b11111).eq(0)
    sat = img.select('QA_RADSAT').eq(0)

    sr = (
        img.select('SR_B.')
        .multiply(0.0000275)
        .add(-0.2)
    )

    lst = (
        img.select('ST_B10')
        .multiply(0.00341802)
        .add(149.0)
        .subtract(273.15)
        .rename('LST')
    )

    ndvi = sr.normalizedDifference(
        ['SR_B5', 'SR_B4']
    ).rename('NDVI')

    ndbi = sr.normalizedDifference(
        ['SR_B6', 'SR_B5']
    ).rename('NDBI')

    mndwi = sr.normalizedDifference(
        ['SR_B3', 'SR_B6']
    ).rename('MNDWI')

    rgb = sr.select([
        'SR_B4', 'SR_B3', 'SR_B2'
    ])

    return (
        ee.Image.cat([
            lst, ndvi, ndbi, mndwi, rgb
        ])
        .updateMask(clear.And(sat))
    )

# ============================================================
# 6. 녹지 경계 및 거리 추출
# ============================================================

def make_layers(y0, y1):

    col = get_collection(y0, y1)

    n_scenes = col.size().getInfo()

    print(f'{y0}-{y1}: 영상 {n_scenes}장')

    if n_scenes == 0:
        raise ValueError('조건에 맞는 영상이 없습니다.')

    # 시기별 중앙값 합성
    comp = col.map(prep).median()

    ndvi = comp.select('NDVI')

    # --------------------------------------------------------
    # NDVI >= 0.20 : 녹지
    # --------------------------------------------------------

    green = ndvi.gte(NDVI_LIMIT)

    green_source = (
        green
        .unmask(0)
        .reproject(crs=CRS, scale=SCALE)
    )

    # --------------------------------------------------------
    # 녹지 경계 추출
    # 시각화를 위한 녹지 가장자리 픽셀
    # --------------------------------------------------------

    green_inner = green_source.focalMin(
        radius=1,
        kernelType='square',
        units='pixels'
    )

    green_boundary = (
        green_source
        .subtract(green_inner)
        .gt(0)
        .selfMask()
        .rename('Green_boundary')
    )

    # --------------------------------------------------------
    # 기존 코드와 동일한 녹지 경계 거리 계산
    # --------------------------------------------------------

    dist = (
        green_source.fastDistanceTransform(
            neighborhood=30,
            units='pixels',
            metric='squared_euclidean'
        )
        .sqrt()
        .multiply(SCALE)
        .subtract(SCALE / 2)
        .max(0)
        .rename('Distance')
    )

    # 녹지 제외
    # 기존 코드와 동일하게 수역은 별도로 제외하지 않음
    analysis_mask = (
        green.Not()
        .And(dist.gte(0))
        .And(dist.lt(MAX_D))
    )

    # 거리별 분석 영역
    distance_bins = (
        dist.divide(BIN)
        .floor()
        .multiply(BIN)
        .updateMask(analysis_mask)
        .rename('Distance_bin')
    )

    # 실제 분석 가능한 유효 픽셀
    valid_mask = (
        analysis_mask
        .And(comp.select('LST').mask())
        .And(comp.select('NDBI').mask())
    )

    # 실제 유효 표본 수 출력
    valid_count = (
        ee.Image.constant(1)
        .rename('valid')
        .updateMask(valid_mask)
        .reduceRegion(
            reducer=ee.Reducer.count(),
            geometry=roi,
            crs=CRS,
            scale=SCALE,
            maxPixels=1e9
        )
        .getInfo()
    )

    print('R23 유효 픽셀 수:', valid_count)

    return {
        'comp': comp,
        'green': green_source.selfMask(),
        'boundary': green_boundary,
        'distance': dist.updateMask(analysis_mask),
        'bins': distance_bins,
        'valid': valid_mask.selfMask()
    }

# ============================================================
# 7. 개발 전후 자료 생성
# ============================================================

before = make_layers(2016, 2017)
after = make_layers(2024, 2025)

# ============================================================
# 8. 시각화 설정
# ============================================================

rgb_vis = {
    'bands': ['SR_B4', 'SR_B3', 'SR_B2'],
    'min': 0.02,
    'max': 0.30,
    'gamma': 1.2
}

ndvi_vis = {
    'min': -0.2,
    'max': 0.8,
    'palette': [
        'A6611A',
        'DFC27D',
        'F5F5F5',
        '80CDC1',
        '018571'
    ]
}

distance_vis = {
    'min': 0,
    'max': 120,
    'palette': [
        '2166AC',
        '92C5DE',
        'FFFFBF',
        'FDAE61',
        'D73027'
    ]
}

lst_vis = {
    'min': 30,
    'max': 50,
    'palette': [
        '313695',
        '74ADD1',
        'FFFFBF',
        'FDAE61',
        'A50026'
    ]
}

# ============================================================
# 9. 지도 생성
# ============================================================

def create_map(data, label):

    Map = geemap.Map()

    Map.add_basemap('SATELLITE')
    Map.centerObject(roi, 16)

    # 분석 시기의 실제 Landsat 영상
    Map.addLayer(
        data['comp'].clip(roi_big),
        rgb_vis,
        f'{label} Landsat RGB',
        True
    )

    # NDVI 분포
    Map.addLayer(
        data['comp'].select('NDVI').clip(roi_big),
        ndvi_vis,
        'NDVI',
        False
    )

    # NDVI >= 0.20 녹지
    Map.addLayer(
        data['green'].clip(roi_big),
        {'palette': ['00AA00']},
        'Green area (NDVI >= 0.20)',
        True,
        0.5
    )

    # 녹지 거리별 분석 영역
    Map.addLayer(
        data['bins'].clip(roi),
        distance_vis,
        'Distance bins (0-150m)',
        False,
        0.8
    )

    # 유효 분석 픽셀
    Map.addLayer(
        data['valid'].clip(roi),
        {'palette': ['FF00FF']},
        'Valid analysis pixels',
        False,
        0.7
    )

    # 지표온도 분포
    Map.addLayer(
        data['comp'].select('LST').clip(roi),
        lst_vis,
        'LST',
        False
    )

    # 녹지 경계
    Map.addLayer(
        data['boundary'].clip(roi_big),
        {'palette': ['FF0000']},
        'Green boundary',
        True
    )

    # 전체 연구대상지 경계
    total_outline = ee.Image().byte().paint(
        roi_total, 1, 2
    )

    Map.addLayer(
        total_outline.selfMask(),
        {'palette': ['FFFF00']},
        'Total study area',
        True
    )

    # R23 연구대상지 경계
    r23_outline = ee.Image().byte().paint(
        roi, 1, 2
    )

    Map.addLayer(
        r23_outline.selfMask(),
        {'palette': ['00FFFF']},
        'R23 boundary',
        True
    )

    # 범례
    Map.add_legend(
        title=f'{label} Green analysis',
        legend_dict={
            'Green area': '#00AA00',
            'Green boundary': '#FF0000',
            'R23 boundary': '#00FFFF',
            'Total study area': '#FFFF00'
        }
    )

    return Map

# ============================================================
# 10. 개발 전후 지도 출력
# ============================================================

print('\n개발 전: 2016-2017')

Map_before = create_map(
    before, '2016-2017'
)

display(Map_before)

print('\n개발 후: 2024-2025')

Map_after = create_map(
    after, '2024-2025'
)

display(Map_after)
